        "rows": [
          [
            "IDLE",
            "The ETH_MDIO line is three-state; there is no clock on ETH_MDC."
          ],
          [
            "PREAMBLE",
            "32 continuous bits of value 1"
          ],
          [
            "START",
            "Start of packet is 0b01"
          ],
          [
            "OPCODE",
            "0b10 for Read and 0b01 for Write"
          ],
          [
            "PHY ADDR ",
            "5-bit address select for one of 32 PHYs"
          ],
          [
            "REG ADDR",
            "Register address in the selected PHY"
          ],
          [
            "TA",
            "Turnaround\n– 0bZ0: Read and post-read increment address\n– 0b10: Write and address MDIO accesses\nwhere Z is the tri-state level "
          ],
          [
            "DATA",
            "Any 16-bit value. In a Write operation, the MAC drives ETH_MDIO. In a \nRead operation, the PHY drives it."
          ]
