            "TIM_CH1\nTIM_CH2",
            "Input/Output",
            "Timer multi-purpose channels.\nEach channel be used for capture, compare, or PWM.\nTIM_CH1 and TIM_CH2 can also be used as external clock \n(below 1/4 of the tim_ker_ck clock), external trigger and \nquadrature encoder inputs."
          ],
          [
            "TIM_CH1N",
            "Output",
            "Timer complementary outputs, derived from TIM_CH1 output \nwith the possibility to have deadtime insertion."
          ],
          [
            "TIM_BKIN",
            "Input / Output ",
            "Break input. This input can also be configured in bidirectional \nmode."
          ]
