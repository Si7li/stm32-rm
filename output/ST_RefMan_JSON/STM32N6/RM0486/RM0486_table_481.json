          [
            "tim_ti1_in[15:0]\ntim_ti2_in[15:0]\ntim_ti3_in[15:0]\ntim_ti4_in[15:0]",
            "Input",
            "Internal timer inputs bus. The \ntim_ti1_in[15:0] and tim_ti2_in[15:0] inputs \ncan be used for capture or as external clock \n(below 1/4 of the tim_ker_ck clock) and for \nquadrature encoder signals."
          ],
          [
            "tim_etr[15:0]",
            "Input",
            "External trigger internal input bus. These \ninputs can be used as trigger, external clock \nor for hardware cycle-by-cycle pulsewidth \ncontrol. These inputs can receive clock with \na frequency higher than the tim_ker_ck if the \ntim_etr_in prescaler is used."
          ],
          [
            "tim_itr[15:0]",
            "Input",
            "Internal trigger input bus. These inputs can \nbe used for the slave mode controller or as a \ninput clock (below 1/4 of the tim_ker_ck \nclock)."
          ],
          [
            "tim_trgo/tim_trgo2",
            "Output",
            "Internal trigger outputs. These triggers are \nused by other timers and /or other \nperipherals."
          ],
          [
            "tim_ocref_clr[7:0]",
            "Input",
            "Timer tim_ocref_clr input bus. These inputs \ncan be used to clear the tim ocxref signals, \ntypically for hardware cycle-by-cycle \npulsewidth control."
          ],
          [
            "tim_brk_cmp[8:1]",
            "Input",
            "Break input for internal signals"
          ],
          [
            "tim_brk2_cmp[8:1]",
            "Input",
            "Break2 input for internal signals"
          ],
          [
